NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/online-compiler

JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=86400

SANDBOX_IMAGE=gcc:14
SANDBOX_RUNTIME=
SANDBOX_MAX_CONCURRENCY=4
SANDBOX_MAX_QUEUE=32
SANDBOX_COMPILE_TIMEOUT_MS=10000
SANDBOX_RUN_TIMEOUT_MS=3000
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_OUTPUT_BYTES=65536

RATE_LIMIT_AUTH_PER_15_MIN=20
RATE_LIMIT_EXECUTIONS_PER_MIN=20

DOCKER_GID=
