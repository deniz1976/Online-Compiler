{
  "name": "online-compiler",
  "version": "2.0.0",
  "description": "Web-based C++ compiler with sandboxed execution",
  "main": "dist/server.js",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandbox:build": "docker build -t online-compiler-sandbox:gcc14 sandbox",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build web",
    "dev:web": "vite web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deniz1976/Online-Compiler.git"
  },
  "keywords": [
    "compiler",
    "c++",
    "online",
    "sandbox"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/deniz1976/Online-Compiler/issues"
  },
  "homepage": "https://github.com/deniz1976/Online-Compiler#readme",
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
